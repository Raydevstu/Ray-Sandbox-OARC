{
  "hooks": {
    "SessionStart": [{"matcher": ".*", "hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/ray-memory-launcher.py\" hook", "timeout": 10}]}],
    "UserPromptSubmit": [{"matcher": ".*", "hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/ray-memory-launcher.py\" hook", "timeout": 10}]}],
    "PreCompact": [{"matcher": ".*", "hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/ray-memory-launcher.py\" hook", "timeout": 10}]}],
    "Stop": [{"matcher": ".*", "hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/ray-memory-launcher.py\" hook", "timeout": 10, "async": true}]}]
  }
}
