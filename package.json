{
  "name": "hindsight-sandbox",
  "version": "0.1.0",
  "private": false,
  "description": "Open-source App Router sandbox for orchestrating agent-memory apps — inspired by Hindsight (vectorize.io). Memory, Prompt Engineering, Context Tuning, Continuous Learning apps with node-graph orchestration, Tier-1 dashboards and benchmarks.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "benchmark:telemetry": "node scripts/telemetry-render-benchmark.mjs",
    "benchmark:submit": "node scripts/codex-benchmark-submit.mjs",
    "memory:quality": "node --experimental-strip-types scripts/memory-quality-evaluate.mjs",
    "smoke:postgres": "node scripts/postgres-smoke-test.mjs",
    "db:migrate:postgres": "node scripts/postgres-migrate.mjs",
    "db:status:postgres": "node scripts/postgres-status.mjs",
    "db:backup:postgres": "node scripts/postgres-backup.mjs",
    "db:verify-backup:postgres": "node scripts/postgres-restore-verify.mjs",
    "quality:audit:postgres": "node --experimental-strip-types scripts/postgres-quality-audit.mjs",
    "quality:slo:workload": "node --experimental-strip-types scripts/slo-workload.mjs",
    "quality:adversarial:report": "npx tsx scripts/adversarial-corpus-report.mjs",
    "quality:slice4:report": "npx tsx scripts/slice-four-evaluation-report.mjs",
    "quality:tier15:report": "node --experimental-strip-types scripts/tier15-benchmark-report.mjs",
    "quality:tier15:profile-repeat": "node --experimental-strip-types scripts/postgres-recall-profile-repeat.mjs",
    "quality:neutral:baseline": "node --experimental-strip-types scripts/neutral-memory-benchmark.mjs",
    "quality:zep:benchmark": "node --experimental-strip-types scripts/zep-neutral-benchmark.mjs",
    "quality:zep:reliability": "node --experimental-strip-types scripts/zep-reliability-benchmark.mjs",
    "quality:hindsight:benchmark": "node --experimental-strip-types scripts/hindsight-neutral-benchmark.mjs",
    "quality:slice4:replay": "npx tsx scripts/slice-four-replay-report.mjs",
    "quality:provider:gemini": "npx tsx scripts/gemini-provider-measurement.mjs",
    "staging:validate": "node scripts/staging-validation.mjs",
    "release:manifest": "node scripts/release-candidate-manifest.mjs",
    "deployment:validate": "node --experimental-strip-types scripts/deployment-validation.mjs",
    "codex:bridge": "node scripts/codex-host-bridge.mjs",
    "hermes:automation:smoke": "node scripts/hermes-automation-smoke.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "lucide-react": "^0.469.0",
    "next": "^15.5.4",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.1.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-playwright": "^2.2.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.1.4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
