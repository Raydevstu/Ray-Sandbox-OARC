    "role": "'user'|'assistant'|'tool'|'system' optional (default user)",
    "content": "optional string",
    "arguments": "optional record (mcp-call)",
    "result": "optional unknown (tool-result)"
  },
  "response": { "ok": true, "data": { "eventId": "...", "duplicate": false, "queued": true, "capture": {} } },
  "notes": [
